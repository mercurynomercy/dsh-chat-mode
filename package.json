{
  "name": "@mercurynomercy/dsh-chat-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 聊天模式：侧栏多一个「聊天」入口，用 DSH 自己的登录和模型聊天，不绑定项目、不再登录；聊天只能联网和读你拖进来的附件。",
  "author": "mercurynomercy",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "chat",
    "ui",
    "i18n",
    "multilingual"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mercurynomercy/dsh-chat-mode.git"
  },
  "homepage": "https://github.com/mercurynomercy/dsh-chat-mode#readme",
  "bugs": {
    "url": "https://github.com/mercurynomercy/dsh-chat-mode/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./read-attachment": "./read-attachment.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "read-attachment.js",
    "lib/*.js",
    "cordis.patch.yml",
    "presets/*.yml",
    "icon.svg",
    "screenshots.json",
    "assets/why-panel.png",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/chat.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1+": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "yaml": "^2.6.1"
  }
}
